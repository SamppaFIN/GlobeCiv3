{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "title": "Implementation plan",
  "description": "Written before any code. Produced by the planning model (Opus/Sonnet), consumed by the implementing model. Must be approved before an implementation ticket is opened.",
  "type": "object",
  "required": ["id", "story", "approach", "steps", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^PLAN-[0-9]{3}$" },
    "story": { "type": "string", "pattern": "^STORY-[0-9]{3}$" },
    "author_model": { "type": "string", "examples": ["Opus 5", "Sonnet 5"] },
    "date": { "type": "string", "format": "date" },
    "approach": { "type": "string", "description": "The chosen solution in a few sentences." },
    "alternatives_considered": {
      "type": "array",
      "description": "Surfacing tradeoffs is the point of this document. An empty array on a non-trivial story is a smell.",
      "items": {
        "type": "object",
        "required": ["name", "pros", "cons"],
        "properties": {
          "name": { "type": "string" },
          "pros": { "type": "string" },
          "cons": { "type": "string" },
          "rejected_because": { "type": "string" }
        }
      }
    },
    "files_to_change": { "type": "array", "items": { "type": "string" } },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Must be empty before status becomes 'approved'."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "action", "verify"],
        "properties": {
          "step": { "type": "integer" },
          "action": { "type": "string" },
          "verify": { "type": "string", "description": "How you know this step worked. 'It compiles' is weak; name the check." }
        }
      }
    },
    "status": { "type": "string", "enum": ["draft", "approved", "superseded"] }
  }
}
